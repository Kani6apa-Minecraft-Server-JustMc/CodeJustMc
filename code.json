{
  "handlers": [
    {
      "type": "player_chat",
      "actions": [
        {
          "action": "if_variable_equals",
          "args": {
            "value": "%event_message%",
            "compare": "@weapons"
          },
          "actions": [
            {
              "action": "cancel_event"
            },
            {
              "action": "call_function",
              "args": {
                "function_name": "give_custom_weapons"
              }
            }
          ]
        },
        {
          "action": "if_variable_equals",
          "args": {
            "value": "%event_message%",
            "compare": "@boss"
          },
          "actions": [
            {
              "action": "cancel_event"
            },
            {
              "action": "call_function",
              "args": {
                "function_name": "spawn_abyss_boss"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "player_right_click",
      "actions": [
        {
          "action": "if_player_holding",
          "args": {
            "item": "minecraft:netherite_sword",
            "hand": "MAIN_HAND"
          },
          "actions": [
            {
              "action": "player_teleport_forward",
              "args": {
                "distance": 6
              }
            },
            {
              "action": "play_sound",
              "args": {
                "sound": "ENTITY_ENDERMAN_TELEPORT",
                "location": "%player_location%",
                "volume": 1.0,
                "pitch": 1.2
              }
            }
          ]
        }
      ]
    },
    {
      "type": "entity_death",
      "actions": [
        {
          "action": "if_variable_equals",
          "args": {
            "value": "%victim_uuid%",
            "compare": "%var(abyss_boss_uuid)%"
          },
          "actions": [
            {
              "action": "set_variable",
              "args": {
                "variable": "abyss_boss_alive",
                "value": 0
              }
            },
            {
              "action": "send_message_all",
              "args": {
                "message": "§5§l[БОСС] §dВладыка Бездны повержен!"
              }
            }
          ]
        }
      ]
    }
  ],
  "functions": [
    {
      "name": "give_custom_weapons",
      "actions": [
        {
          "action": "give_item",
          "args": {
            "item": "minecraft:netherite_sword"
          }
        },
        {
          "action": "give_item",
          "args": {
            "item": "minecraft:blaze_rod"
          }
        },
        {
          "action": "send_message",
          "args": {
            "message": "§aТестовые оружия выданы!"
          }
        }
      ]
    },
    {
      "name": "spawn_abyss_boss",
      "actions": [
        {
          "action": "spawn_mob",
          "args": {
            "mob_type": "WITHER_SKELETON",
            "location": "%player_location%",
            "custom_name": "§5§lВладыка Бездны",
            "max_health": 250.0,
            "save_uuid_to": "abyss_boss_uuid"
          }
        },
        {
          "action": "set_variable",
          "args": {
            "variable": "abyss_boss_alive",
            "value": 1
          }
        },
        {
          "action": "send_message_all",
          "args": {
            "message": "§5§l[ВНИМАНИЕ] §dВладыка Бездны призван!"
          }
        }
      ]
    }
  ]
}
