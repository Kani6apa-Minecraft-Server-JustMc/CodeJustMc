// ⚔ ОРУЖЕЙНАЯ — 8 оружий для JustMC
// При входе каждый игрок получает весь арсенал.

event<player_join> {
    player::give_items([
        item("bow", "⚡ Громовой лук", 1, ["Стрела призывает молнию при попадании"]),
        item("bow", "💥 Взрывной лук", 1, ["Стрела создаёт взрыв при попадании"]),
        item("iron_sword", "🌀 Клинок Сумасброда", 1, ["Разворачивает жертву на 180°"]),
        item("diamond_sword", "⚡ Меч Грозы", 1, ["Призывает молнию в жертву удара"]),
        item("netherite_sword", "🩸 Клинок Вампира", 1, ["Вампиризм: лечит атакующего"]),
        item("iron_axe", "🌪 Молот Ветров", 1, ["Подбрасывает жертву в воздух"]),
        item("golden_sword", "☠ Кинжал Отравителя", 1, ["Отравляет жертву и слабит её"]),
        item("trident", "🔱 Трезубец Скача", 1, ["ПКМ — рывок вперёд по взгляду"])
    ], 1);
    player::message([
        "⚔ Оружейник выдал тебе 8 оружий:",
        "⚡ Громовой лук — молния при попадании",
        "💥 Взрывной лук — взрыв при попадании",
        "🌀 Клинок Сумасброда — разворот жертвы на 180°",
        "⚡ Меч Грозы — молния в жертву",
        "🩸 Клинок Вампира — вампиризм",
        "🌪 Молот Ветров — подбрасывает жертву",
        "☠ Кинжал Отравителя — отравляет жертву",
        "🔱 Трезубец Скача — ПКМ: рывок вперёд"
    ]);
    player::action_bar("⚔ Арсенал выдан: 8 оружий!");
}

event<player_shot_bow> {
    if (player::is_holding([item("bow", "⚡ Громовой лук", 1, ["Стрела призывает молнию при попадании"])], "EITHER_HAND", "IGNORE_DURABILITY_AND_STACK_SIZE")) {
        entity<projectile>::set_custom_name("ob_w_l");
        entity<projectile>::set_custom_name_visibility("FALSE");
    }
    if (player::is_holding([item("bow", "💥 Взрывной лук", 1, ["Стрела создаёт взрыв при попадании"])], "EITHER_HAND", "IGNORE_DURABILITY_AND_STACK_SIZE")) {
        entity<projectile>::set_custom_name("ob_w_e");
        entity<projectile>::set_custom_name_visibility("FALSE");
    }
}

event<player_projectile_hit> {
    if (entity<projectile>::name_equals(["ob_w_l"])) {
        world::spawn_lightning_bolt(value::location<projectile>);
        player::message("⚡ Громовой лук: молния поразила цель!");
    }
    if (entity<projectile>::name_equals(["ob_w_e"])) {
        world::create_explosion(value::location<projectile>, 3);
        player::message("💥 Взрывной лук: точное попадание!");
    }
}

event<entity_take_damage> {
    // защита от рекурсии: урон молнии не запускает эффекты повторно
    if not (value::event_damage_cause == "LIGHTNING") {
        if (player<damager_player>::is_holding([item("iron_sword", "🌀 Клинок Сумасброда", 1, ["Разворачивает жертву на 180°"])], "EITHER_HAND", "IGNORE_DURABILITY_AND_STACK_SIZE")) {
            var ob_floc = value::location;
            ob_floc = ob_floc.shift_location_in_direction(-2, "FORWARD");
            entity::face_location(ob_floc);
        }
        if (player<damager_player>::is_holding([item("diamond_sword", "⚡ Меч Грозы", 1, ["Призывает молнию в жертву удара"])], "EITHER_HAND", "IGNORE_DURABILITY_AND_STACK_SIZE")) {
            world::spawn_lightning_bolt(value::location);
        }
        if (player<damager_player>::is_holding([item("netherite_sword", "🩸 Клинок Вампира", 1, ["Вампиризм: лечит атакующего"])], "EITHER_HAND", "IGNORE_DURABILITY_AND_STACK_SIZE")) {
            player<damager_player>::set_health(value::current_health<damager_player> + value::event_damage);
        }
        if (player<damager_player>::is_holding([item("iron_axe", "🌪 Молот Ветров", 1, ["Подбрасывает жертву в воздух"])], "EITHER_HAND", "IGNORE_DURABILITY_AND_STACK_SIZE")) {
            entity::launch_up(2.5, "FALSE");
        }
        if (player<damager_player>::is_holding([item("golden_sword", "☠ Кинжал Отравителя", 1, ["Отравляет жертву и слабит её"])], "EITHER_HAND", "IGNORE_DURABILITY_AND_STACK_SIZE")) {
            entity::give_potion_effects([potion("poison", 1, 200), potion("weakness", 1, 100)], "FALSE", "TRUE", "REGULAR");
        }
    }
}

event<player_right_click> {
    if (player::is_holding([item("trident", "🔱 Трезубец Скача", 1, ["ПКМ — рывок вперёд по взгляду"])], "EITHER_HAND", "IGNORE_DURABILITY_AND_STACK_SIZE")) {
        player::launch_forward(2.5, "FALSE", "YAW_AND_PITCH");
        player::play_sound(sound("item.trident.riptide_1"));
        player::set_item_cooldown(item("trident", "🔱 Трезубец Скача", 1, ["ПКМ — рывок вперёд по взгляду"]), 60, sound("item.trident.riptide_2"));
    }
}
